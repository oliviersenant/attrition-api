# Copie ce fichier en `.env` et renseigne tes valeurs. NE JAMAIS committer `.env`.

# --- Base de données PostgreSQL ---
# Dev local (docker-compose ; port hôte 5433 pour ne pas gêner un Postgres système) :
DATABASE_URL=postgresql+psycopg://futurisys:futurisys@localhost:5433/attrition
# Prod (Postgres managé Neon/Supabase) : injecté via secret, ne pas mettre ici.

# --- Sécurité de l'API ---
# Clé attendue dans l'en-tête HTTP (X-API-Key) pour appeler les endpoints protégés.
API_KEY=change-me-en-local
